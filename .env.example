# WealthPilot v3.2 环境变量配置
# 复制为 .env 并填入真实值：cp .env.example .env
# 注意：.env 已在 .gitignore 中，绝不应提交到版本控制

# OpenAI API Key（必填）
# 获取地址：https://platform.openai.com/api-keys
WEALTHPILOT_OPENAI_API_KEY=sk-your-key-here

# 隔离 Demo（默认禁止真实行情、LLM、券商/交易接口）
PUBLIC_DEMO_MODE=true
DEMO_ACCESS_PASSWORD=change-this-demo-password
DEMO_ALLOW_MARKET_DATA=false
WEALTHPILOT_DB_PATH=data/wealthpilot-demo.db
BROKER_MODE=mock
WP_USE_SKILL_RETRIEVE_PRINCIPLES=false
WP_USE_SKILL_OUTPUT_VALIDATOR=false

# 如果使用自定义 API 代理（可选）
# OPENAI_BASE_URL=https://your-proxy.com/v1

# Alpha Vantage API Key（可选，用于美股数据）
# 单 key 模式(向后兼容):
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# 多 key 轮换模式(v3.4,每个 key 25 次/天,4 个共 100 次):
# AV_API_KEY_1=your_key_1
# AV_API_KEY_2=your_key_2
# AV_API_KEY_3=your_key_3
# AV_API_KEY_4=your_key_4

# 盈米 MCP API Key（可选，用于基金数据）
# 获取地址：联系盈米开放平台
YINGMI_API_KEY=your_yingmi_api_key_here
YINGMI_MCP_URL=https://stargate.yingmi.com/mcp/v2

# ===== Tiger Brokers OpenAPI =====
# 获取方式: https://developer.itigerup.com/profile
TIGER_ID=
TIGER_LICENSE=TBNZ
TIGER_PRIVATE_KEY_PATH=backend/secrets/tiger_private_key.pem
TIGER_ACCOUNT=
TIGER_ENV=PROD
TIGER_LANGUAGE=zh_CN

# 只读模式护栏:为 true 时禁止调用任何下单/改单/撤单接口
TIGER_READ_ONLY_MODE=true

# ===== Futu Brokers OpenAPI =====
# 需要 OpenD 网关运行在本地(富途牛牛 PC 客户端自带,或单独安装)
FUTU_ACCOUNT=
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_READ_ONLY_MODE=true

# ===== Snowball Securities (雪盈) OpenAPI =====
SNOWBALL_ACCOUNT=
SNOWBALL_SECRET_KEY=
SNOWBALL_ENV=prod
SNOWBALL_READ_ONLY_MODE=true

# ===== 国金证券 QMT 网关 =====
# VM 内 wp_qmt_gateway.py 的地址和鉴权密钥
GUOJIN_GATEWAY_URL=http://10.211.55.7:8000
GUOJIN_GATEWAY_SECRET=wp_guojin_2024

# ===== Interactive Brokers (IBKR) =====
# 需要 TWS 或 IB Gateway 运行在本地
# 端口: 4002=模拟盘(paper), 4001=实盘(live)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_READ_ONLY_MODE=true
# 实盘交易开关(默认 false,仅允许模拟盘账号 DU 开头)
ENABLE_IBKR_LIVE_TRADING=false
