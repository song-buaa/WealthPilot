            },
            "title": "Assets",
            "type": "array"
          },
          "notice": {
            "title": "Notice",
            "type": "string"
          }
        },
        "required": [
          "schema_version",
          "synthetic",
          "source",
          "as_of",
          "currency",
          "amount_unit",
          "minor_unit_scale",
          "total_assets_minor",
          "total_liabilities_minor",
          "net_worth_minor",
          "assets",
          "notice"
        ],
        "type": "object",
        "$defs": {
          "AssetBucket": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "cash",
                  "fixed_income",
                  "equity",
                  "other"
                ],
                "title": "Category",
                "type": "string"
              },
              "amount_minor": {
                "minimum": 0,
                "title": "Amount Minor",
                "type": "integer"
              }
            },
            "required": [
              "category",
              "amount_minor"
            ],
            "title": "AssetBucket",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "title": "WealthSummary"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "_meta": {
        "securitySchemes": [
          {
            "type": "noauth"
          }
        ]
      }
    }
